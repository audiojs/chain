{
  "name": "@audio/chain",
  "version": "0.1.1",
  "description": "Auto-Chain — analysis-driven processing chain: measure, build an adaptive stage list, apply it, show the recipe (Dolby.io Media Enhance class, classical DSP, no ML)",
  "type": "module",
  "sideEffects": false,
  "main": "chain.js",
  "exports": {
    ".": "./chain.js",
    "./audio": {
      "types": "./audio.d.ts",
      "default": "./audio.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "chain.js",
    "audio.js",
    "audio.d.ts"
  ],
  "dependencies": {
    "@audio/denoise-declick": "^0.1.6",
    "@audio/denoise-dehum": "^0.1.5",
    "@audio/denoise-detect": "^0.2.0",
    "@audio/denoise-wiener": "^0.1.8",
    "@audio/dynamics-deesser": "^0.2.5",
    "@audio/dynamics-limiter": "^0.1.4",
    "@audio/dynamics-multiband": "^0.4.1",
    "@audio/eq-fir": "^1.0.2",
    "@audio/filter-biquad": "^2.0.0",
    "@audio/loudness-lra": "^1.1.2",
    "@audio/loudness-lufs": "^1.0.0",
    "@audio/loudness-truepeak": "^1.1.5",
    "@audio/noise-estimate": "^1.0.2",
    "@audio/spatial-midside": "^1.1.2",
    "@audio/spectral-ltas": "^1.1.2",
    "@audio/spectral-target": "^1.0.0",
    "@audio/stft": "^1.0.3",
    "@audio/vad": "^1.0.0"
  },
  "keywords": [
    "audio",
    "dsp",
    "auto-chain",
    "mastering",
    "enhance",
    "loudness",
    "denoise",
    "eq",
    "recipe"
  ],
  "license": "MIT",
  "author": "Dmitry Iv. <dfcreative@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/audiojs/chain.git"
  },
  "homepage": "https://github.com/audiojs/chain#readme",
  "bugs": {
    "url": "https://github.com/audiojs/chain/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node --test test.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "audio": "./audio.js"
}
